{
  "name": "opencode-devkit",
  "version": "1.0.0",
  "private": true,
  "description": "Набор расширений для OpenCode V2: навыки, команды, агенты, локальные плагины, админка и инструменты",
  "scripts": {
    "test": "node --test scripts/tests/*.test.js scripts/tests/*.test.mjs",
    "smoke": "node scripts/smoke-admin.js",
    "smoke:ci": "node scripts/smoke-admin.js --ci",
    "reaudit": "node scripts/reaudit.js",
    "skill:lint": "node scripts/skill-lint.js",
    "install": "node install.js"
  }
}
