{
  "sound": true,
  "notification": true,
  "bell": false,
  "timeout": 5,
  "showProjectName": true,
  "showFullPath": false,
  "showSessionTitle": false,
  "showIcon": true,
  "suppressWhenFocused": true,
  "focusOnClick": true,
  "enableOnDesktop": false,
  "minDuration": 10,
  "deferCompleteUntilChildrenIdle": true,
  "deferredCompleteTimeout": 900000,
  "events": {
    "permission": { "sound": true, "notification": true, "bell": false },
    "complete": { "sound": true, "notification": true, "bell": false },
    "subagent_complete": { "sound": false, "notification": false, "bell": false },
    "error": { "sound": true, "notification": true, "bell": false },
    "question": { "sound": true, "notification": true, "bell": false },
    "user_cancelled": { "sound": false, "notification": false, "bell": false },
    "session_started": { "sound": false, "notification": false, "bell": false },
    "user_message": { "sound": false, "notification": false, "bell": false }
  },
  "messages": {
    "permission": "OpenCode ждёт разрешения: {projectName}",
    "complete": "OpenCode закончил: {projectName}",
    "subagent_complete": "Подзадача завершена: {projectName}",
    "error": "Ошибка в OpenCode: {projectName}",
    "question": "OpenCode задал вопрос: {projectName}",
    "user_cancelled": "Сессия отменена: {projectName}"
  },
  "volumes": {
    "permission": 0.7,
    "complete": 0.5,
    "error": 0.8,
    "question": 0.7
  }
}
